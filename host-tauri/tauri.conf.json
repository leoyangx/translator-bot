{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "翻译机器人",
  "version": "0.0.5",
  "identifier": "app.translatorbot.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "./nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGQ0RDMkFGRUQzNjU5MTgKUldRWVdUYnRyOExORCt5VXJpL3BrRTJlNVVZRjZZWGNuZWhJOTZpeTJWMlA2VFFadG9XSTdsMFIK",
      "endpoints": [
        "https://github.com/leoyangx/translator-bot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
